{
  // Laboratorio BDP v7 en la nube (GitHub Codespaces) · Dr. Abel Coronado.
  // El MISMO laboratorio de la versión portable, sin interfaz gráfica: bdp_start.py lo descarga
  // (verifica sha256) al crear el codespace y lo enciende cada vez que el codespace arranca.
  // Curso por omisión: UP (HDFS + Jupyter + Elasticsearch). Para UNIR: python3 bdp_start.py unir
  "name": "BDP v7 · Laboratorio en la nube",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "hostRequirements": { "cpus": 4, "memory": "16gb", "storage": "32gb" },
  // Sin "features": el laboratorio es autocontenido (Python, JDK, Hadoop, Spark, ES) y una feature
  // que use apt puede romper la creación (p.ej. llave GPG vencida de un repositorio de la imagen base).
  // Entorno del lab en TODAS las terminales, incluso las que se abren antes de que termine la
  // instalación (mismas variables que bdp_start.py; el lab fija Python 3.12).
  "remoteEnv": {
    "BDP_HOME": "/home/vscode/bdp-v7",
    "JAVA_HOME": "/home/vscode/bdp-v7/portable/common_jdk",
    "HADOOP_HOME": "/home/vscode/bdp-v7/portable/hadoop",
    "HADOOP_CONF_DIR": "/home/vscode/bdp-v7/portable/hadoop/etc/hadoop",
    "HADOOP_OPTS": "--add-opens=java.base/java.lang=ALL-UNNAMED --add-opens=java.base/java.util=ALL-UNNAMED --add-opens=java.base/java.nio=ALL-UNNAMED",
    "HADOOP_HEAPSIZE_MAX": "512m",
    "SPARK_HOME": "/home/vscode/bdp-v7/portable/python/lib/python3.12/site-packages/pyspark",
    "PYSPARK_PYTHON": "/home/vscode/bdp-v7/portable/python/bin/python3",
    "PYSPARK_DRIVER_PYTHON": "/home/vscode/bdp-v7/portable/python/bin/python3",
    "KAFKA_LOG4J_OPTS": "-Dlog4j2.configurationFile=file:///home/vscode/bdp-v7/portable/kafka_kraft/config/tools-log4j2.yaml",
    "PATH": "/home/vscode/bdp-v7/portable/python/bin:/home/vscode/bdp-v7/portable/hadoop/bin:/home/vscode/bdp-v7/portable/python/lib/python3.12/site-packages/pyspark/bin:/home/vscode/bdp-v7/portable/kafka_kraft/bin:/home/vscode/bdp-v7/portable/common_jdk/bin:${containerEnv:PATH}"
  },
  "postCreateCommand": "python3 bdp_start.py install",
  "postStartCommand": "python3 bdp_start.py ${BDP_PROFILE:-up}",
  "forwardPorts": [8888, 9870],
  "portsAttributes": {
    "8888": { "label": "JupyterLab (BDP v7, sin token)", "onAutoForward": "notify" },
    "9870": { "label": "HDFS · NameNode", "onAutoForward": "silent" },
    "9200": { "label": "Elasticsearch", "onAutoForward": "silent" },
    "9864": { "label": "HDFS · DataNode", "onAutoForward": "silent" },
    "5001": { "label": "API de predicción (Semana 4)", "onAutoForward": "notify" },
    "8501": { "label": "App Streamlit (Semana 3)", "onAutoForward": "notify" }
  },
  "otherPortsAttributes": { "onAutoForward": "silent" },
  "customizations": {
    "vscode": {
      "extensions": ["ms-toolsai.jupyter", "ms-python.python"]
    },
    "codespaces": {
      "openFiles": ["LEEME.md"]
    }
  }
}
